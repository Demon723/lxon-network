// SPDX-License-Identifier: MIT
pragma solidity ^0.8.26;

import "@layerzerolabs/contracts/interfaces/ILayerZeroEndpoint.sol";
import "@layerzerolabs/contracts/interfaces/ILayerZeroReceiver.sol";
import "./LxonBridgeMultiSig.sol";

/**
 * @title LxonBridgeLayerZero
 * @notice LXON Bridge with LayerZero cross-chain messaging
 * @dev Integrates LxonBridgeMultiSig with LayerZero for trustless cross-chain communication
 */
contract LxonBridgeLayerZero is ILayerZeroReceiver {
    ILayerZeroEndpoint public immutable endpoint;
    LxonBridgeMultiSig public immutable bridge;

    // Mapping of trusted remote addresses (peer bridges on other chains)
    mapping(uint16 => bytes) public trustedRemoteAddresses;

    // LayerZero chain IDs
    uint16 public constant LZ_MAINNET = 101;
    uint16 public constant LZ_SEPOLIA = 10101;
    uint16 public constant LZ_HOLESKY = 10300;

    // Events
    event CrossChainTransferSent(
        uint16 indexed dstChainId,
        address indexed recipient,
        address indexed token,
        uint256 amount
    );

    event CrossChainTransferReceived(
        uint16 indexed srcChainId,
        address indexed recipient,
        address indexed token,
        uint256 amount
    );

    event TrustedRemoteSet(uint16 indexed srcChainId, bytes srcAddress);

    /**
     * @notice Constructor
     * @param _endpoint LayerZero endpoint address
     * @param _bridge LxonBridgeMultiSig address
     */
    constructor(address _endpoint, address _bridge) {
        endpoint = ILayerZeroEndpoint(_endpoint);
        bridge = LxonBridgeMultiSig(_bridge);
    }

    /**
     * @notice Send cross-chain transfer via LayerZero
     * @param _dstChainId LayerZero destination chain ID
     * @param _recipient Recipient address on destination chain
     * @param _token Token address
     * @param _amount Amount to transfer
     * @param _refundAddress Address to refund unused gas
     */
    function sendCrossChainTransfer(
        uint16 _dstChainId,
        address _recipient,
        address _token,
        uint256 amount,
        address _refundAddress
    ) external payable {
        // Check if trusted remote is set
        bytes memory trustedRemote = trustedRemoteAddresses[_dstChainId];
        require(trustedRemote.length > 0, "Trusted remote not set");

        // Encode payload
        bytes memory payload = abi.encode(_recipient, _token, amount);

        // Send via LayerZero
        endpoint.send{value: msg.value}(
            _dstChainId,
            trustedRemote,
            payload,
            _refundAddress,
            address(0x0),
            bytes("")
        );

        emit CrossChainTransferSent(_dstChainId, _recipient, _token, amount);
    }

    /**
     * @notice LayerZero receive function
     * @param _srcChainId Source chain ID
     * @param _srcAddress Source address
     * @param _nonce Nonce
     * @param _payload Payload data
     */
    function lzReceive(
        uint16 _srcChainId,
        bytes memory _srcAddress,
        uint64 _nonce,
        bytes memory _payload
    ) external override {
        // Only endpoint can call this
        require(msg.sender == address(endpoint), "Only endpoint can call");

        // Decode payload
        (address recipient, address token, uint256 amount) = abi.decode(
            _payload,
            (address, address, uint256)
        );

        // Execute bridge transfer logic
        // Note: This would need to be adapted based on the actual bridge logic
        // For now, emit event for demonstration
        emit CrossChainTransferReceived(_srcChainId, recipient, token, amount);
    }

    /**
     * @notice Set trusted remote address for a chain
     * @param _srcChainId Source chain ID
     * @param _srcAddress Source address (this contract on source chain)
     */
    function setTrustedRemote(
        uint16 _srcChainId,
        bytes calldata _srcAddress
    ) external {
        // Add access control here (e.g., only timelock or admin)
        trustedRemoteAddresses[_srcChainId] = _srcAddress;
        emit TrustedRemoteSet(_srcChainId, _srcAddress);
    }

    /**
     * @notice Estimate gas for cross-chain transfer
     * @param _dstChainId Destination chain ID
     * @param _payload Payload data
     * @return Estimated gas
     */
    function estimateFee(
        uint16 _dstChainId,
        bytes memory _payload
    ) external view returns (uint256) {
        bytes memory trustedRemote = trustedRemoteAddresses[_dstChainId];
        require(trustedRemote.length > 0, "Trusted remote not set");

        (uint256 fee, ) = endpoint.estimateFees(
            _dstChainId,
            address(this),
            _payload,
            false,
            bytes("")
        );

        return fee;
    }

    /**
     * @notice Get bridge contract
     * @return Bridge address
     */
    function getBridge() external view returns (address) {
        return address(bridge);
    }

    /**
     * @notice Get endpoint contract
     * @return Endpoint address
     */
    function getEndpoint() external view returns (address) {
        return address(endpoint);
    }
}
