pragma solidity ^0.8.26;

import "forge-std/Script.sol";
import "../contracts/LxonBridgeLayerZero.sol";
import "../contracts/LxonBridgeMultiSig.sol";

contract DeployLxonBridgeLayerZero_Sepolia is Script {
    function run() external {
        // LayerZero Sepolia endpoint
        address lzEndpoint = 0xbfD2135BFf0bD076E2387b9e7B25b4fb1680d1b4;

        // Existing LXON bridge on Sepolia (deployed separately)
        address lxonBridge = 0x[PASTE_SEPOLIA_BRIDGE_ADDRESS_HERE];

        vm.startBroadcast();

        LxonBridgeLayerZero bridge = new LxonBridgeLayerZero(
            lzEndpoint,
            lxonBridge
        );

        console.log("LxonBridgeLayerZero deployed on Sepolia Testnet");
        console.log("Address:", address(bridge));
        console.log("LayerZero Endpoint:", lzEndpoint);
        console.log("LXON Bridge:", lxonBridge);

        vm.stopBroadcast();
    }
}

