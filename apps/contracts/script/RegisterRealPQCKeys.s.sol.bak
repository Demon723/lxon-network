pragma solidity ^0.8.26;

import "forge-std/Script.sol";
import "../contracts/HybridSignatureVerifier.sol";

contract RegisterRealPQCKeys is Script {
    function run() external {
        uint256 deployerPrivateKey = vm.envUint("DEPLOYER_PRIVATE_KEY");
        
        // Hybrid verifier address from deployment
        address hybridVerifierAddress = 0x9744B2CbD83AD1a1BA2B02fE2158624e2f8AB7D0;
        
        // Validator addresses
        address validator1 = 0x43410E73d2Ef4B2638BE10265e8BE3D2FDfFDc27;
        address validator2 = 0x7F715B7F78a7d1D63455F3e2Ec1fa31D516f9Ef3;
        address validator3 = 0x7999b8C0662FE6aE3d82Ac6988718189E66f9B4b;
        
        // Real ML-DSA-65 public keys (1952 bytes each, hex encoded)
        // From MLDSA65_VALIDATOR_KEYS.md
        bytes memory publicKey1 = hex"";
        
        bytes memory publicKey2 = hex"";
        
        bytes memory publicKey3 = hex"";
        
        console.log("Registering real ML-DSA-65 public keys on-chain");
        console.log("Hybrid Verifier:", hybridVerifierAddress);
        
        HybridSignatureVerifier hybridVerifier = HybridSignatureVerifier(hybridVerifierAddress);
        
        vm.startBroadcast(deployerPrivateKey);
        
        // Revoke dummy keys
        hybridVerifier.revokeMLDSAPublicKey(validator1);
        console.log("Revoked dummy key for validator 1");
        
        hybridVerifier.revokeMLDSAPublicKey(validator2);
        console.log("Revoked dummy key for validator 2");
        
        hybridVerifier.revokeMLDSAPublicKey(validator3);
        console.log("Revoked dummy key for validator 3");
        
        // Register real keys
        hybridVerifier.registerMLDSAPublicKey(validator1, publicKey1);
        console.log("Registered real ML-DSA-65 public key for validator 1");
        
        hybridVerifier.registerMLDSAPublicKey(validator2, publicKey2);
        console.log("Registered real ML-DSA-65 public key for validator 2");
        
        hybridVerifier.registerMLDSAPublicKey(validator3, publicKey3);
        console.log("Registered real ML-DSA-65 public key for validator 3");
        
        vm.stopBroadcast();
        
        // Verify registration
        console.log("\n=== Verification ===");
        console.log("Validator 1 has PQC key:", hybridVerifier.hasMLDSAPublicKey(validator1));
        console.log("Validator 2 has PQC key:", hybridVerifier.hasMLDSAPublicKey(validator2));
        console.log("Validator 3 has PQC key:", hybridVerifier.hasMLDSAPublicKey(validator3));
        
        console.log("\n=== PQC Migration Status ===");
        console.log("Phase 1: Inventory and Freeze - COMPLETE");
        console.log("Phase 2: Add PQC Verifier - COMPLETE");
        console.log("Phase 3: Hybrid Mode - COMPLETE");
        console.log("Phase 4: Key Rotation - COMPLETE (real keys registered)");
        console.log("Phase 5: Classical Sunset - PENDING");
    }
}
