{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DiscoveryReadOnly",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeImages",
        "ec2:DescribeAddresses",
        "ec2:DescribeKeyPairs",
        "ec2:DescribeSecurityGroups"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RunOnlyTaggedEncryptedSmallGravitonInEuNorth1",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "lxon",
          "ec2:InstanceType": [
            "t4g.micro",
            "t4g.small"
          ],
          "ec2:Region": "eu-north-1",
          "ec2:Encrypted": "true",
          "ec2:MetadataHttpTokens": "required"
        }
      }
    },
    {
      "Sid": "TagOnlyLxonRequests",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1",
          "aws:RequestTag/Project": "lxon"
        }
      }
    },
    {
      "Sid": "SupportingResourcesForOneNode",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateKeyPair",
        "ec2:CreateSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AllocateAddress",
        "ec2:AssociateAddress"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        }
      }
    },
    {
      "Sid": "StopBillingForLxonResources",
      "Effect": "Allow",
      "Action": [
        "ec2:TerminateInstances"
      ],
      "Resource": "arn:aws:ec2:eu-north-1:044409363656:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1",
          "ec2:ResourceTag/Project": "lxon"
        }
      }
    },
    {
      "Sid": "ReleaseNetworkAndKeyMaterial",
      "Effect": "Allow",
      "Action": [
        "ec2:DisassociateAddress",
        "ec2:ReleaseAddress",
        "ec2:DeleteSecurityGroup",
        "ec2:DeleteKeyPair"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        }
      }
    },
    {
      "Sid": "NeverEscalateOrExtendBlastRadius",
      "Effect": "Deny",
      "Action": [
        "iam:*",
        "organizations:*",
        "account:*",
        "sts:GetFederatedToken",
        "sts:SetSourceIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NeverSpinExpensiveOrNonGravitonCapacity",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "ec2:InstanceType": [
            "t4g.micro",
            "t4g.small"
          ]
        }
      }
    }
  ]
}
