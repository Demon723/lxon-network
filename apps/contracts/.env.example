# LXON Smart Contracts Environment Template

# ============ RPC Endpoints ============

# Ethereum Mainnet
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/alch_-M67KA0p-MXWA27XaGo5T

# Ethereum Testnets
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/alch_-M67KA0p-MXWA27XaGo5T
HOLESKY_RPC_URL=https://eth-holesky.g.alchemy.com/v2/alch_-M67KA0p-MXWA27XaGo5T

# Layer 2s (for future x402 integration)
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/alch_-M67KA0p-MXWA27XaGo5T
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/alch_-M67KA0p-MXWA27XaGo5T
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/alch_-M67KA0p-MXWA27XaGo5T
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/alch_-M67KA0p-MXWA27XaGo5T

# LXON Native Network
LXON_RPC_URL=http://3.110.221.224:8545
LXON_MAINNET_RPC_URL=http://3.110.221.224:8545

# ============ Deployment Account ============
# NEVER commit real private keys! Use test/mock keys only

# For testnet deployment
PRIVATE_KEY=0x

# ============ API Keys ============

# Etherscan verification (mainnet, testnets, etc.)
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Basescan verification (Base L2)
BASESCAN_API_KEY=YOUR_KEY

# Arbiscan verification (Arbitrum)
ARBISCAN_API_KEY=YOUR_KEY

# Polygonscan verification (Polygon)
POLYGONSCAN_API_KEY=YOUR_KEY

# Infura API key (alternative RPC provider)
INFURA_API_KEY=YOUR_INFURA_API_KEY

# ============ Multi-Sig Governance Configuration ============
# CRITICAL: Replace placeholder addresses with real owner addresses before mainnet deployment

# Main Governance Multi-Sig (3/5 threshold, 7-day timelock)
MULTISIG_ADDRESS=0x0000000000000000000000000000000000000000
MULTISIG_OWNERS=0x0000000000000000000000000000000000000000,0x0000000000000000000000000000000000000000,0x0000000000000000000000000000000000000000,0x0000000000000000000000000000000000000000,0x0000000000000000000000000000000000000000

# Emergency Multi-Sig (2/3 threshold, 24-hour timelock)
EMERGENCY_MULTISIG_ADDRESS=0x0000000000000000000000000000000000000000
EMERGENCY_OWNERS=0x0000000000000000000000000000000000000000,0x0000000000000000000000000000000000000000,0x0000000000000000000000000000000000000000

# ============ Deployment Options ============

# Gas reporting
REPORT_GAS=true
COINMARKETCAP_API_KEY=YOUR_KEY

# Enable forking for testnet simulation
FORKING=false

# Source verification
SOURCIFY_ENABLED=false

# ============ Notes ============
# 1. Get RPC endpoints from:
#    - Alchemy: https://www.alchemy.com
#    - Infura: https://infura.io
#    - QuickNode: https://www.quicknode.com
#
# 2. Get API keys from:
#    - Etherscan: https://etherscan.io/apis
#    - Basescan: https://basescan.org/apis
#    - Arbiscan: https://arbiscan.io/apis
#
# 3. For local development:
#    - Use `npx hardhat node` for local Hardhat network
#    - No private key needed for hardhat
#
# 4. Security:
#    - Never commit .env with real private keys
#    - Use environment variables or secret management
#    - For production, use hardware wallets or key management services
#
# 5. Testnet faucets:
#    - Sepolia: https://sepoliafaucet.com
#    - Holesky: https://holesky-faucet.pk910.de
#    - Base Sepolia: https://www.coinbase.com/faucets/base-ethereum-goerli-faucet
