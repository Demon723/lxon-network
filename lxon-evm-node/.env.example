# LXON chain (chainId 724) stack configuration — copy to .env and adjust.
# Every value below already matches the docker-compose.yml defaults, so the
# stack runs without a .env at all. REGENERATE the secrets before production use.

# Blockscout secrets (dev values — replace for anything public-facing).
SECRET_KEY_BASE=replace-me-64-bytes-base64-or-hex-generated-by-deploy-sh
DB_PASSWORD=replace-me-generated-by-deploy-sh

# RPC backend for Blockscout — the Geth archive node (Erigon cannot be used:
# Erigon v3 removed Clique consensus support entirely).
RPC_VARIANT=geth
RPC_HTTP_URL=http://geth-sealer:8545
RPC_TRACE_URL=http://geth-sealer:8545
RPC_WS_URL=ws://geth-sealer:8546
