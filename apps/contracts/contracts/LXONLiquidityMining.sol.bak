// SPDX-License-Identifier: MIT
pragma solidity ^0.8.26;

import "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import "@openzeppelin/contracts/access/Ownable.sol";
import "@openzeppelin/contracts/utils/ReentrancyGuard.sol";

/**
 * @title LXONLiquidityMining
 * @dev Liquidity mining contract to incentivize LP providers with LXON token rewards
 * @notice Rewards liquidity providers based on their contribution to LXON trading pairs
 */
contract LXONLiquidityMining is Ownable, ReentrancyGuard {
    using SafeERC20 for IERC20;

    // State variables
    IERC20 public rewardToken; // LXON token
    IERC20 public lpToken; // LP token (e.g., LXON/WETH)
    
    uint256 public rewardRate; // Tokens per second
    uint256 public lastUpdateTime;
    uint256 public rewardPerTokenStored;
    
    uint256 public totalStaked;
    uint256 public farmingStartTime;
    uint256 public farmingEndTime;
    
    // User data
    mapping(address => uint256) public userRewardPerTokenPaid;
    mapping(address => uint256) public userStaked;
    mapping(address => uint256) public userRewards;
    
    // Configuration
    uint256 public constant REWARD_DURATION = 90 days; // 90-day farming period
    uint256 public constant MIN_STAKE_AMOUNT = 1e6; // Minimum 1 LXON
    uint256 public constant MAX_REWARD_RATE = 1000 ether / 1 days; // Max 1000 LXON per day
    
    // Events
    event Staked(address indexed user, uint256 amount);
    event Withdrawn(address indexed user, uint256 amount);
    event RewardClaimed(address indexed user, uint256 amount);
    event RewardRateUpdated(uint256 oldRate, uint256 newRate);
    event FarmingPeriodUpdated(uint256 startTime, uint256 endTime);
    
    /**
     * @dev Constructor to initialize the liquidity mining contract
     * @param _rewardToken Address of the LXON token
     * @param _lpToken Address of the LP token
     * @param _rewardRate Initial reward rate (tokens per second)
     * @param _farmingStartTime When farming starts
     */
    constructor(
        address _rewardToken,
        address _lpToken,
        uint256 _rewardRate,
        uint256 _farmingStartTime
    ) Ownable(msg.sender) {
        require(_rewardToken != address(0), "Invalid reward token address");
        require(_lpToken != address(0), "Invalid LP token address");
        require(_rewardRate > 0 && _rewardRate <= MAX_REWARD_RATE, "Invalid reward rate");
        require(_farmingStartTime >= block.timestamp, "Invalid start time");
        
        rewardToken = IERC20(_rewardToken);
        lpToken = IERC20(_lpToken);
        rewardRate = _rewardRate;
        lastUpdateTime = _farmingStartTime;
        farmingStartTime = _farmingStartTime;
        farmingEndTime = _farmingStartTime + REWARD_DURATION;
    }
    
    /**
     * @dev Update reward calculation for the contract
     */
    function updateReward() public {
        if (block.timestamp <= lastUpdateTime) {
            return;
        }
        
        if (block.timestamp >= farmingEndTime) {
            uint256 remainingTime = farmingEndTime - lastUpdateTime;
            uint256 reward = remainingTime * rewardRate;
            rewardPerTokenStored += (reward * 1e18) / totalStaked;
            lastUpdateTime = farmingEndTime;
        } else {
            uint256 elapsed = block.timestamp - lastUpdateTime;
            uint256 reward = elapsed * rewardRate;
            rewardPerTokenStored += (reward * 1e18) / totalStaked;
            lastUpdateTime = block.timestamp;
        }
    }
    
    /**
     * @dev Calculate pending rewards for a user
     * @param _user Address of the user
     * @return Pending rewards
     */
    function pendingRewards(address _user) public view returns (uint256) {
        uint256 _rewardPerTokenStored = rewardPerTokenStored;
        uint256 _lastUpdateTime = lastUpdateTime;
        
        if (block.timestamp > _lastUpdateTime && totalStaked > 0) {
            if (block.timestamp >= farmingEndTime) {
                uint256 remainingTime = farmingEndTime - _lastUpdateTime;
                uint256 reward = remainingTime * rewardRate;
                _rewardPerTokenStored += (reward * 1e18) / totalStaked;
            } else {
                uint256 elapsed = block.timestamp - _lastUpdateTime;
                uint256 reward = elapsed * rewardRate;
                _rewardPerTokenStored += (reward * 1e18) / totalStaked;
            }
        }
        
        return (userStaked[_user] * (_rewardPerTokenStored - userRewardPerTokenPaid[_user])) / 1e18 + userRewards[_user];
    }
    
    /**
     * @dev Stake LP tokens to earn rewards
     * @param _amount Amount of LP tokens to stake
     */
    function stake(uint256 _amount) external nonReentrant {
        require(_amount >= MIN_STAKE_AMOUNT, "Amount below minimum stake");
        require(block.timestamp >= farmingStartTime, "Farming not started");
        require(block.timestamp < farmingEndTime, "Farming ended");
        
        updateReward();
        
        // Transfer LP tokens from user to contract
        lpToken.safeTransferFrom(msg.sender, address(this), _amount);
        
        // Calculate pending rewards before updating stake
        uint256 pending = pendingRewards(msg.sender);
        userRewards[msg.sender] = pending;
        userRewardPerTokenPaid[msg.sender] = rewardPerTokenStored;
        
        // Update user stake
        userStaked[msg.sender] += _amount;
        totalStaked += _amount;
        
        emit Staked(msg.sender, _amount);
    }
    
    /**
     * @dev Withdraw staked LP tokens
     * @param _amount Amount of LP tokens to withdraw
     */
    function withdraw(uint256 _amount) external nonReentrant {
        require(userStaked[msg.sender] >= _amount, "Insufficient staked amount");
        
        updateReward();
        
        // Calculate pending rewards before updating stake
        uint256 pending = pendingRewards(msg.sender);
        userRewards[msg.sender] = pending;
        userRewardPerTokenPaid[msg.sender] = rewardPerTokenStored;
        
        // Update user stake
        userStaked[msg.sender] -= _amount;
        totalStaked -= _amount;
        
        // Transfer LP tokens back to user
        lpToken.safeTransfer(msg.sender, _amount);
        
        emit Withdrawn(msg.sender, _amount);
    }
    
    /**
     * @dev Claim accumulated rewards
     */
    function claimRewards() external nonReentrant {
        updateReward();
        
        uint256 pending = pendingRewards(msg.sender);
        require(pending > 0, "No rewards to claim");
        
        userRewards[msg.sender] = 0;
        userRewardPerTokenPaid[msg.sender] = rewardPerTokenStored;
        
        // Transfer rewards to user
        uint256 contractBalance = rewardToken.balanceOf(address(this));
        require(contractBalance >= pending, "Insufficient reward tokens");
        
        rewardToken.safeTransfer(msg.sender, pending);
        
        emit RewardClaimed(msg.sender, pending);
    }
    
    /**
     * @dev Withdraw staked LP tokens and claim rewards in one transaction
     */
    function exit() external nonReentrant {
        uint256 staked = userStaked[msg.sender];
        require(staked > 0, "No staked tokens");
        
        withdraw(staked);
        claimRewards();
    }
    
    /**
     * @dev Update the reward rate (only owner)
     * @param _newRate New reward rate
     */
    function setRewardRate(uint256 _newRate) external onlyOwner {
        require(_newRate > 0 && _newRate <= MAX_REWARD_RATE, "Invalid reward rate");
        
        updateReward();
        
        uint256 oldRate = rewardRate;
        rewardRate = _newRate;
        
        emit RewardRateUpdated(oldRate, _newRate);
    }
    
    /**
     * @dev Update farming period (only owner)
     * @param _newStartTime New farming start time
     * @param _newEndTime New farming end time
     */
    function setFarmingPeriod(uint256 _newStartTime, uint256 _newEndTime) external onlyOwner {
        require(_newStartTime >= block.timestamp, "Invalid start time");
        require(_newEndTime > _newStartTime, "Invalid end time");
        require(totalStaked == 0, "Cannot change period with active stakes");
        
        farmingStartTime = _newStartTime;
        farmingEndTime = _newEndTime;
        lastUpdateTime = _newStartTime;
        rewardPerTokenStored = 0;
        
        emit FarmingPeriodUpdated(_newStartTime, _newEndTime);
    }
    
    /**
     * @dev Recover unused reward tokens (only owner)
     * @param _amount Amount to recover
     */
    function recoverRewardTokens(uint256 _amount) external onlyOwner {
        require(block.timestamp >= farmingEndTime, "Farming still active");
        require(_amount > 0, "Invalid amount");
        
        uint256 contractBalance = rewardToken.balanceOf(address(this));
        require(contractBalance >= _amount, "Insufficient balance");
        
        rewardToken.safeTransfer(owner(), _amount);
    }
    
    /**
     * @dev Get user information
     * @param _user Address of the user
     * @return staked, pending, farmingActive
     */
    function getUserInfo(address _user) external view returns (
        uint256 staked,
        uint256 pending,
        bool farmingActive
    ) {
        staked = userStaked[_user];
        pending = pendingRewards(_user);
        farmingActive = block.timestamp >= farmingStartTime && block.timestamp < farmingEndTime;
    }
    
    /**
     * @dev Get contract information
     * @return totalStaked, rewardRate, farmingStartTime, farmingEndTime, rewardPerTokenStored
     */
    function getContractInfo() external view returns (
        uint256 _totalStaked,
        uint256 _rewardRate,
        uint256 _farmingStartTime,
        uint256 _farmingEndTime,
        uint256 _rewardPerTokenStored
    ) {
        return (
            totalStaked,
            rewardRate,
            farmingStartTime,
            farmingEndTime,
            rewardPerTokenStored
        );
    }
}